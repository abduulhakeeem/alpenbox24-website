# AlpenBox24 — Hostinger (LiteSpeed, Apache-compatible) configuration
# Copied to public_html by the build. Edit SITE_HOST if the domain differs.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://alpenbox24.de%{REQUEST_URI} [L,R=301]

  # 2) www -> apex
  RewriteCond %{HTTP_HOST} ^www\.alpenbox24\.de$ [NC]
  RewriteRule ^ https://alpenbox24.de%{REQUEST_URI} [L,R=301]

  # 3) Friendly redirects for guessed URLs
  RewriteRule ^about/?$ /ueber-uns/ [L,R=301]
  RewriteRule ^ueber/?$ /ueber-uns/ [L,R=301]
  RewriteRule ^contact/?$ /kontakt/ [L,R=301]
  RewriteRule ^anfahrt/?$ /kontakt/#route [L,R=301,NE]
  RewriteRule ^gallery/?$ /galerie/ [L,R=301]
  RewriteRule ^datenschutzerklaerung/?$ /datenschutz/ [L,R=301]
  RewriteRule ^privacy/?$ /datenschutz/ [L,R=301]
  RewriteRule ^impressum\.html$ /impressum/ [L,R=301]
  RewriteRule ^english/?$ /en/ [L,R=301]

  # 4) Add trailing slash to extension-less paths that exist as directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # 5) Block direct access to bundled PHP libraries
  RewriteRule ^api/vendor/ - [F,L]

  # 6) Block access to dotfiles except .well-known
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Never serve PHP mail config or vendor source directly
<FilesMatch "^(config.*\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Astro fingerprints JS, CSS and processed images in /_astro/ -> safe to cache for a year.
  # Fonts in /fonts/ are not fingerprinted: rename the file if you ever replace it.
  <FilesMatch "\.(avif|webp|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Un-hashed public images (icons, OG images, logo): 30 days
  <FilesMatch "\.(jpe?g|png|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddDefaultCharset utf-8
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/manifest+json text/plain application/xml
</IfModule>
