# Admin uploads (logo, favicon): images only, never executable, never scriptable.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<FilesMatch "\.(?!(png|svg|webp|ico)$)[^.]+$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Even if an SVG is opened directly, it cannot run scripts or load anything.
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
