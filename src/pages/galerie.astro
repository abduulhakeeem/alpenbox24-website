---
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { gallery, cats } from '../data/gallery';
import credits from '../data/photo-credits.json';
import { u } from '../lib/url';

const all = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const items = await Promise.all(
  gallery.map(async (g) => {
    const src = all[`../assets/photos/${g.name}.jpg`].default;
    const full = await getImage({ src, width: 1800, format: 'webp', quality: 78 });
    const c = credits[g.name as keyof typeof credits];
    return { ...g, src, w: c.width, h: c.height, full: full.src, credit: `Foto: ${c.author} · ${c.license}` };
  }),
);
---
<Base
  title="Galerie: Automaten bei Tag und Nacht – AlpenBox24"
  description="Bilder von Verkaufsautomaten bei Tag und Nacht: Snack- und Getränkeautomaten, Regionalautomaten am Hof und das Oberland rund um Miesbach."
  breadcrumbs={[{ name: 'Galerie', href: '/galerie/' }]}
>
  <PageHead
    title="Galerie"
    lead="Automaten bei Tag und bei Nacht, vom Bauernhof bis nach Tokio. Bilder von unseren eigenen Standorten kommen bald dazu."
    crumbs={[{ name: 'Galerie', href: '/galerie/' }]}
  />
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <nav class="filters" data-filter-bar aria-label="Bilder filtern">
        <a class="chip" href="#alle" data-filter="alle" aria-current="true">Alle</a>
        {cats.map((c) => <a class="chip" href={`#${c.id}`} data-filter={c.id}>{c.label}</a>)}
      </nav>
      <div class="masonry">
        {cats.map((c) => (
          <>
            <h2 class="cat-head" id={c.id} data-cat-head={c.id}>{c.label}</h2>
            {items.filter((i) => i.cat === c.id).map((i, n) => (
              <figure data-cat={i.cat}>
                <a href={i.full} data-lb data-alt={i.alt} data-caption={i.caption} data-credit={i.credit}>
                  <Picture src={i.src} alt={i.alt} widths={[400, 700, 1000]} width={1000} height={Math.round(1000 * i.h / i.w)} sizes="(min-width: 1300px) 22vw, (min-width: 900px) 30vw, 50vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={70} loading={c.id === cats[0].id && n < 3 ? 'eager' : 'lazy'} fetchpriority={c.id === cats[0].id && n === 0 ? 'high' : 'auto'} />
                </a>
                <figcaption><strong>{i.caption}</strong><a href={u('/bildnachweise/') + '#' + i.name} class="muted" style="text-decoration:none">{i.credit}</a></figcaption>
              </figure>
            ))}
          </>
        ))}
      </div>
    </div>
  </section>
</Base>
