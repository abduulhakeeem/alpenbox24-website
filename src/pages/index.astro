---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Horizon from '../components/Horizon.astro';
import SplitText from '../components/SplitText.astro';
import Marquee from '../components/Marquee.astro';
import DayCycle from '../components/DayCycle.astro';
import MapBlock from '../components/MapBlock.astro';
import Icon from '../components/Icon.astro';
import { machines } from '../data/machines';
import { gallery } from '../data/gallery';
import { site } from '../data/site';
import { u } from '../lib/url';

const tiles = machines.filter((m) => m.id !== 'standort').slice(0, 6);
const main = site.locations[0];
const stripNames = ['automat-tokio-nacht', 'regiomat-holz', 'automat-grabgo', 'automat-reihe-akita', 'kartoffelautomat', 'automat-metro'];
const strip = stripNames.map((n) => gallery.find((g) => g.name === n)!).filter(Boolean);
---
<Base
  title="AlpenBox24 – 24/7 Automaten in Miesbach und Umgebung"
  description="AlpenBox24: Snacks, Getränke und Regionales aus unseren Automaten, rund um die Uhr. Unser 24/7-Minimarkt in Miesbach und weitere Standorte im Überblick."
  hero
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Photo name="automat-drei-nacht" alt="" eager credit={false} widths={[640, 960, 1280, 1920, 2560]} sizes="100vw" position="62% 50%" />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__grain" aria-hidden="true"></div>
    <div class="wrap hero__content">
      <h1 id="hero-title">
        <span class="hero__big"><SplitText text="Nie geschlossen." base={200} /></span>
        <span class="hero__sub">Unsere Automaten. Rund um die Uhr.</span>
      </h1>
      <p class="lead">Snacks, kalte Getränke und Regionales, direkt aus unseren Automaten. In Miesbach und an weiteren Standorten.</p>
      <div class="cta-row">
        <span class="signpost-wrap"><a class="signpost" href={u('/standorte/')}>Standorte ansehen</a></span>
        <a class="btn" href={u('/automaten/')}>Unsere Automaten</a>
      </div>
    </div>
    <Horizon />
    <a class="hero__scroll" href="#typen">Weiter</a>
    <div class="hero__credit"><a class="photo__credit" href={u('/bildnachweise/#automat-drei-nacht')}>Beispielfoto: mrhayata · CC BY-SA 2.0</a></div>
  </section>

  <Marquee items={['Snacks', 'Getränke', 'Regionales', '24 Stunden', 'Mehrere Standorte']} />

  <section class="section" id="typen" aria-labelledby="typen-title">
    <div class="wrap">
      <h2 id="typen-title" class="statement" data-reveal>Was in unseren Automaten <em>steckt.</em></h2>
      <div class="bento mt-7">
        {tiles.map((m, i) => (
          <a class:list={['bento__tile', `bento__tile--${i}`]} href={u(`/automaten/#${m.id}`)} data-reveal="clip" style={`--d:${i * 90}`}>
            <Photo name={m.photo as any} alt={m.alt} credit={false} widths={[480, 800, 1200]} sizes="(min-width: 960px) 40vw, 100vw" />
            <span class="bento__label"><strong>{m.name}</strong><span>{m.line}</span></span>
          </a>
        ))}
      </div>
      <p class="muted mt-5" style="font-size:var(--fs-small)">Beispielfotos aus Wikimedia Commons. Urheber und Lizenzen findest du unter <a href={u('/bildnachweise/')}>Bildnachweise</a>.</p>
    </div>
  </section>

  <DayCycle />

  <section class="band" aria-label="Für wen">
    <Photo name="regiomat-holz" alt="" sizes="100vw" widths={[800, 1280, 1920]} credit={false} position="50% 40%" />
    <div class="wrap band__text">
      <p class="statement" data-reveal>Wenn alles zu hat, <em>haben wir offen.</em></p>
    </div>
  </section>

  <section class="section" aria-labelledby="einblicke-title">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:end;gap:1rem;flex-wrap:wrap">
      <h2 id="einblicke-title" data-reveal>Licht an, Fach auf.</h2>
      <a class="btn" href={u('/galerie/')}>Zur Galerie</a>
    </div>
    <ul class="strip mt-6" aria-label="Bilder aus der Galerie">
      {strip.map((p) => (
        <li><a href={u('/galerie/')}>
          <Photo name={p.name as any} alt={p.alt} credit={false} widths={[400, 700, 900]} sizes="(min-width: 960px) 26rem, 78vw" />
          <span class="strip__cap">{p.caption}</span>
        </a></li>
      ))}
    </ul>
  </section>

  <Marquee sun items={['24 Stunden', '7 Tage', '365 Tage', 'Selbstbedienung', 'Kein Ladenschluss']} speed={44} />

  <section class="section" aria-labelledby="miesbach-title">
    <div class="wrap grid-2">
      <div class="stack">
        <p class="kicker" data-reveal>Standorte</p>
        <h2 id="miesbach-title" data-reveal style="--d:80">Hier findest du uns.</h2>
        {main && <p class="muted" data-reveal style="--d:160"><strong>{main.name}</strong><br />{main.address}{main.hours && <><br />{main.hours}</>}</p>}
        <div class="cta-row" data-reveal style="--d:240">
          <span class="signpost-wrap"><a class="signpost" href={u('/standorte/')}>Alle Standorte</a></span>
          {main && <a class="btn" href={main.mapsUrl} rel="noopener" target="_blank"><Icon name="route" />Route planen</a>}
        </div>
      </div>
      <div data-reveal style="--d:120"><MapBlock /></div>
    </div>
  </section>

  <section class="section section--fels" aria-labelledby="cta-title">
    <div class="wrap center stack">
      <h2 id="cta-title" class="statement" style="margin-inline:auto">Platz für einen Automaten? <em>Sprich uns an.</em></h2>
      <p class="cta-row" style="justify-content:center"><span class="signpost-wrap"><a class="signpost" href={u('/kontakt/?anliegen=standort#formular')}>Standort anbieten</a></span><a class="btn" href={u('/kontakt/')}>Kontakt</a></p>
    </div>
  </section>
</Base>
