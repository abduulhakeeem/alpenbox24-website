---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Horizon from '../components/Horizon.astro';
import SplitText from '../components/SplitText.astro';
import Marquee from '../components/Marquee.astro';
import DayCycle from '../components/DayCycle.astro';
import MapBlock from '../components/MapBlock.astro';
import Icon from '../components/Icon.astro';
import { machines } from '../data/machines';
import { site } from '../data/site';
import { u } from '../lib/url';

const tiles = machines.filter((m) => m.id !== 'wunsch').slice(0, 6);
const strip = ['automat-tokio-nacht', 'regiomat-holz', 'automat-grabgo', 'automat-reihe-akita', 'kartoffelautomat', 'automat-metro'] as const;
---
<Base
  title="AlpenBox24 – Verkaufsautomaten kaufen & aufstellen"
  description="Snack-, Getränke- und Regionalautomaten kaufen und aufstellen lassen: AlpenBox24 aus Miesbach liefert, baut auf und bringt deinen Automaten zum Laufen."
  hero
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Photo name="automat-drei-nacht" alt="" eager credit={false} widths={[640, 960, 1280, 1920, 2560]} sizes="100vw" position="62% 50%" />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__grain" aria-hidden="true"></div>
    <div class="wrap hero__content">
      <h1 id="hero-title">
        <span class="hero__big"><SplitText text="Nie geschlossen." base={200} /></span>
        <span class="hero__sub">Verkaufsautomaten kaufen und aufstellen lassen.</span>
      </h1>
      <p class="lead">Wir liefern deinen Automaten, bauen ihn auf und bringen ihn zum Laufen. Von Miesbach aus, überall hin.</p>
      <div class="cta-row">
        <span class="signpost-wrap"><a class="signpost" href={u('/kontakt/?anliegen=kauf#formular')}>Automat anfragen</a></span>
        <a class="btn" href={u('/automaten/')}>Automaten ansehen</a>
      </div>
    </div>
    <Horizon />
    <a class="hero__scroll" href="#typen">Runter scrollen</a>
    <div class="hero__credit"><a class="photo__credit" href={u('/bildnachweise/#automat-drei-nacht')}>Beispielfoto: mrhayata · CC BY-SA 2.0</a></div>
  </section>

  <Marquee items={['Snackautomaten', 'Getränkeautomaten', 'Regionalautomaten', '24/7-Shops', 'Lieferung & Aufbau']} />

  <section class="section" id="typen" aria-labelledby="typen-title">
    <div class="wrap">
      <h2 id="typen-title" class="statement" data-reveal>Für jedes Produkt <em>der passende Automat.</em></h2>
      <div class="bento mt-7">
        {tiles.map((m, i) => (
          <a class:list={['bento__tile', `bento__tile--${i}`]} href={u(`/automaten/#${m.id}`)} data-reveal="clip" style={`--d:${i * 90}`}>
            <Photo name={m.photo as any} alt={m.alt} credit={false} widths={[480, 800, 1200]} sizes="(min-width: 960px) 40vw, 100vw" />
            <span class="bento__label"><strong>{m.name}</strong><span>{m.line}</span></span>
          </a>
        ))}
      </div>
      <p class="muted mt-5" style="font-size:var(--fs-small)">Beispielfotos aus Wikimedia Commons, Urheber unter <a href={u('/bildnachweise/')}>Bildnachweise</a>.</p>
    </div>
  </section>

  <section class="section section--fels" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" data-reveal>So einfach geht’s.</h2>
      <ol class="steps mt-7" role="list">
        <li class="step" data-reveal><span class="step__line" aria-hidden="true"></span><h3>Anfragen</h3><p>Sag uns, was du verkaufen willst und wo.</p></li>
        <li class="step" data-reveal style="--d:120"><span class="step__line" aria-hidden="true"></span><h3>Liefern & aufbauen</h3><p>Wir bringen den Automaten und stellen ihn auf.</p></li>
        <li class="step" data-reveal style="--d:240"><h3>Verkaufen</h3><p>Befüllen, Preise setzen, fertig. Ab jetzt rund um die Uhr.</p></li>
      </ol>
    </div>
  </section>

  <DayCycle />

  <section class="band" aria-label="Für wen">
    <Photo name="regiomat-holz" alt="" sizes="100vw" widths={[800, 1280, 1920]} credit={false} position="50% 40%" />
    <div class="wrap band__text">
      <p class="statement" data-reveal>Hofladen. Firma. Hotel. Verein. Gemeinde. <em>Überall, wo jemand etwas braucht.</em></p>
    </div>
  </section>

  <section class="section" aria-labelledby="einblicke-title">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:end;gap:1rem;flex-wrap:wrap">
      <h2 id="einblicke-title" data-reveal>Automaten, überall.</h2>
      <a class="btn" href={u('/galerie/')}>Zur Galerie</a>
    </div>
    <div class="strip mt-6" role="list">
      {strip.map((p) => (
        <a role="listitem" href={u('/galerie/')}>
          <Photo name={p} alt="" credit={false} widths={[400, 700, 900]} sizes="(min-width: 960px) 26rem, 78vw" />
        </a>
      ))}
    </div>
  </section>

  <Marquee sun items={['24 Stunden', '7 Tage', '365 Tage', 'Kein Personal', 'Kein Ladenschluss']} speed={44} />

  <section class="section" aria-labelledby="miesbach-title">
    <div class="wrap grid-2">
      <div class="stack">
        <p class="kicker" data-reveal>Live ansehen</p>
        <h2 id="miesbach-title" data-reveal style="--d:80">Unsere eigene Box läuft in Miesbach.</h2>
        <p class="muted" data-reveal style="--d:160">{site.address.street}, {site.address.zip} {site.address.city}. Täglich 0–24 Uhr. Schau vorbei und sieh dir an, wie es funktioniert.</p>
        <div class="cta-row" data-reveal style="--d:240">
          <a class="btn" href={u('/miesbach/')}><Icon name="pin" />AlpenBox24 Miesbach</a>
        </div>
      </div>
      <div data-reveal style="--d:120"><MapBlock /></div>
    </div>
  </section>

  <section class="section section--fels" aria-labelledby="cta-title">
    <div class="wrap center stack">
      <h2 id="cta-title" class="statement" style="margin-inline:auto">Du willst einen Automaten? <em>Schreib uns.</em></h2>
      <p class="cta-row" style="justify-content:center"><span class="signpost-wrap"><a class="signpost" href={u('/kontakt/?anliegen=kauf#formular')}>Automat anfragen</a></span></p>
    </div>
  </section>
</Base>
