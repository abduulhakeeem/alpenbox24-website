---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { site, telHref, mailHref, whatsappHref } from '../../data/site';
import { u, STAGING } from '../../lib/url';

/** Values must match $anliegenMap in public/api/kontakt.php. */
const reasons = [
  { value: 'frage', icon: 'hand', title: 'Frage zu einem Automaten', line: 'Etwas klemmt, fehlt oder ist unklar? Sag uns, an welchem Standort.' },
  { value: 'wunsch', icon: 'cookie', title: 'Produktwunsch', line: 'Was sollen wir als Nächstes ins Fach legen?' },
  { value: 'standort', icon: 'pin', title: 'Standort anbieten', line: 'Du hast Platz für einen Automaten? Erzähl uns davon.' },
  { value: 'sonstiges', icon: 'chat', title: 'Etwas anderes', line: 'Lob, Kritik, Presse oder eine Idee: immer her damit.' },
] as const;
const main = site.locations[0];
---
<Base
  title="Kontakt – AlpenBox24 Miesbach"
  description="Frage zu einem Automaten, Produktwunsch oder Platz für einen neuen Standort? Schreib AlpenBox24 aus Miesbach. Wir melden uns so schnell wie möglich."
  breadcrumbs={[{ name: 'Kontakt', href: '/kontakt/' }]}
>
  <PageHead title="Schreib uns." lead="Eine Frage, ein Wunsch oder Platz für einen neuen Automaten im Landkreis Miesbach? Wir lesen jede Nachricht und melden uns so schnell wie möglich." crumbs={[{ name: 'Kontakt', href: '/kontakt/' }]} />

  <section class="section contact" style="padding-top:0" id="formular" aria-label="Kontaktformular">
    <div class="wrap contact__grid">
      <div>
        <p class="notice" data-form-error hidden role="alert">Das hat leider nicht geklappt. Bitte versuch es noch einmal oder schreib direkt an <a href={mailHref}>{site.email}</a>.</p>
        {STAGING && <p class="notice">Vorschau: Das Formular verschickt erst auf dem Live-Server E-Mails. Bis dahin erreichst du uns unter <a href={mailHref}>{site.email}</a>.</p>}

        <form class="form contact__form" method="post" action={u('/api/kontakt.php')} data-form>
          <fieldset class="reasons">
            <legend>Worum geht’s?</legend>
            <div class="reasons__grid">
              {reasons.map((r, i) => (
                <label class="reason">
                  <input type="radio" name="anliegen" value={r.value} checked={i === 0} required />
                  <span class="reason__box">
                    <Icon name={r.icon} />
                    <strong>{r.title}</strong>
                    <span>{r.line}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="contact__row">
            <div class="field">
              <label for="name">Dein Name</label>
              <input class="input" type="text" id="name" name="name" autocomplete="name" required maxlength="120" />
              <span class="error">Bitte gib deinen Namen an.</span>
            </div>
            <div class="field">
              <label for="email">Deine E-Mail-Adresse</label>
              <input class="input" id="email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="200" />
              <span class="error">Bitte gib eine gültige E-Mail-Adresse an, z. B. name@beispiel.de.</span>
            </div>
          </div>

          <div class="field">
            <label for="telefon">Telefon <span class="muted">(optional)</span></label>
            <input class="input" id="telefon" name="telefon" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" />
            <span class="hint">Falls wir dich lieber anrufen sollen.</span>
          </div>

          <div class="field field--ort">
            <label for="ort">Wo ist der Platz für den Automaten?</label>
            <input class="input" type="text" id="ort" name="ort" maxlength="120" placeholder="Adresse oder Ort" />
            <span class="hint">Drinnen oder draußen? Gibt es Strom in der Nähe? Gern auch in die Nachricht.</span>
          </div>

          <div class="field">
            <label for="nachricht">Deine Nachricht</label>
            <textarea class="textarea" id="nachricht" name="nachricht" required maxlength="4000" rows="6"></textarea>
            <span class="hint hint--frage">Nenn uns am besten den Standort und, falls vorhanden, die Nummer am Automaten.</span>
            <span class="hint hint--wunsch">Je genauer, desto besser: Marke, Sorte, Standort.</span>
            <span class="error">Bitte schreib uns kurz, worum es geht.</span>
          </div>

          <div class="hp" aria-hidden="true"><label for="website">Website</label><input type="text" id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <input type="hidden" name="_ts" value="" />

          <div class="check">
            <input type="checkbox" id="dsgvo" name="dsgvo" required />
            <label for="dsgvo">Ich habe die <a href={u('/datenschutz/#kontakt')}>Datenschutzerklärung</a> gelesen. Meine Angaben werden nur zur Bearbeitung meiner Nachricht verwendet.</label>
          </div>

          <div class="contact__submit">
            <span class="signpost-wrap"><button class="signpost" type="submit">Nachricht senden <Icon name="arrowRight" /></button></span>
            <span class="muted">Alle Felder ohne „optional“ sind Pflicht.</span>
          </div>
        </form>
      </div>

      <aside class="contact__aside" aria-label="Direkter Kontakt">
        <div class="card-nap">
          <h2>Lieber direkt?</h2>
          <ul class="icon-list" role="list">
            <li><Icon name="mail" /><div><strong>E-Mail</strong><p><a href={mailHref}>{site.email}</a></p></div></li>
            {telHref && <li><Icon name="phone" /><div><strong>Telefon</strong><p><a href={telHref}>{site.phone.display}</a></p></div></li>}
            {whatsappHref && <li><Icon name="chat" /><div><strong>WhatsApp</strong><p><a href={whatsappHref} rel="noopener" target="_blank">Nachricht schreiben</a></p></div></li>}
            {main && <li><Icon name="pin" /><div><strong>{main.name}</strong><p>{main.address}{main.hours && <><br />{main.hours}</>}</p></div></li>}
          </ul>
          <a class="btn" href={u('/standorte/')}>Alle Standorte</a>
        </div>
      </aside>
    </div>
  </section>
</Base>
<style>
  .contact__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 1000px) { .contact__grid { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); } .contact__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .contact__form { margin-top: var(--s-5); gap: var(--s-6); }
  .contact__row { display: grid; gap: var(--s-5); }
  @media (min-width: 700px) { .contact__row { grid-template-columns: 1fr 1fr; } }
  .contact__aside h2 { font-size: var(--fs-3); }

  .reasons { border: 0; padding: 0; margin: 0; min-width: 0; }
  .reasons legend { font-weight: 700; margin-bottom: var(--s-4); font-size: 1.1rem; }
  .reasons__grid { display: grid; gap: 0.75rem; }
  @media (min-width: 560px) { .reasons__grid { grid-template-columns: 1fr 1fr; } }
  .reason { position: relative; display: block; cursor: pointer; }
  .reason input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .reason__box {
    display: grid; grid-template-columns: 2.4rem 1fr; column-gap: 0.85rem; row-gap: 0.2rem; height: 100%;
    padding: 1rem 1.1rem; border: 1px solid var(--c-grat-2); border-radius: 8px; background: var(--c-fels);
    transition: border-color var(--t-fast), background var(--t-base), transform 300ms var(--ease-spring);
  }
  .reason__box :global(svg) { grid-row: span 2; width: 2.4rem; height: 2.4rem; padding: 0.55rem; border-radius: 50%; background: var(--c-grat); color: var(--c-stein); transition: background var(--t-base), color var(--t-base); }
  .reason__box strong { font-size: 1.02rem; line-height: 1.3; }
  .reason__box span { color: var(--c-stein); font-size: var(--fs-small); line-height: 1.45; }
  .reason:hover .reason__box { border-color: var(--c-stein); }
  .reason input:checked + .reason__box { border-color: var(--c-laerche); background: color-mix(in srgb, var(--c-laerche) 9%, var(--c-fels)); }
  .reason input:checked + .reason__box :global(svg) { background: var(--c-laerche); color: var(--c-nacht); }
  .reason input:focus-visible + .reason__box { outline: 2px solid var(--c-sonne); outline-offset: 3px; }
  .reason input:active + .reason__box { transform: scale(0.985); }

  /* Context: the location field and message hints follow the chosen reason (no JS needed) */
  .field--ort, .hint--frage, .hint--wunsch { display: none; }
  .contact__form:has(input[value='standort']:checked) .field--ort { display: grid; animation: field-in 400ms var(--ease-out); }
  .contact__form:has(input[value='frage']:checked) .hint--frage,
  .contact__form:has(input[value='wunsch']:checked) .hint--wunsch { display: block; }
  @keyframes field-in { from { opacity: 0; transform: translateY(-6px); } }

  .contact__submit { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; }
  .contact__submit .signpost { border: 0; cursor: pointer; }
  .contact__submit .muted { font-size: var(--fs-small); }
</style>
