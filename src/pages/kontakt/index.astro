---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { site, telHref, mailHref, whatsappHref } from '../../data/site';
import { u, STAGING } from '../../lib/url';
---
<Base
  title="Kontakt – AlpenBox24"
  description="Frage zu einem Automaten, Produktwunsch oder Platz für einen neuen Standort? Schreib AlpenBox24 aus Miesbach, wir melden uns so schnell wie möglich."
  breadcrumbs={[{ name: 'Kontakt', href: '/kontakt/' }]}
>
  <PageHead title="Kontakt" lead="Schreib uns. Wir melden uns." crumbs={[{ name: 'Kontakt', href: '/kontakt/' }]} />

  <section class="section" style="padding-top:0" id="formular" aria-label="Anfrage">
    <div class="wrap grid-2" style="align-items:start">
      <div>
        <p class="notice" data-form-error hidden role="alert">Das hat nicht geklappt. Bitte versuch es noch einmal oder schreib an {site.email}.</p>
        {STAGING && <p class="notice">Vorschau: Das Formular verschickt erst auf dem Hostinger-Server E-Mails.</p>}
        <form class="form mt-5" method="post" action={u('/api/kontakt.php')} data-form>
          <div class="field">
            <label for="anliegen">Worum geht’s? *</label>
            <select class="select" id="anliegen" name="anliegen" required>
              <option value="frage" selected>Frage zu einem Automaten</option>
              <option value="wunsch">Produktwunsch</option>
              <option value="standort">Standort anbieten</option>
              <option value="sonstiges">Sonstiges</option>
            </select>
          </div>
          <div class="field">
            <label for="name">Name *</label>
            <input class="input" id="name" name="name" autocomplete="name" required maxlength="120" />
            <span class="error">Bitte gib deinen Namen an.</span>
          </div>
          <div class="field">
            <label for="email">E-Mail *</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
            <span class="error">Bitte gib eine gültige E-Mail-Adresse an.</span>
          </div>
          <div class="field">
            <label for="telefon">Telefon <span class="muted">(optional)</span></label>
            <input class="input" id="telefon" name="telefon" type="tel" autocomplete="tel" maxlength="40" />
          </div>
          <div class="field">
            <label for="ort">Standort <span class="muted">(optional)</span></label>
            <input class="input" id="ort" name="ort" maxlength="120" placeholder="z. B. Miesbach oder deine Adresse" />
          </div>
          <div class="field">
            <label for="nachricht">Nachricht *</label>
            <textarea class="textarea" id="nachricht" name="nachricht" required maxlength="4000" placeholder="Worum geht’s?"></textarea>
            <span class="error">Bitte schreib uns kurz, worum es geht.</span>
          </div>
          <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <input type="hidden" name="_ts" value="" />
          <div class="check">
            <input type="checkbox" id="dsgvo" name="dsgvo" required />
            <label for="dsgvo">Ich habe die <a href={u('/datenschutz/#kontakt')}>Datenschutzerklärung</a> gelesen. *</label>
          </div>
          <div><span class="signpost-wrap"><button class="signpost" type="submit" style="border:0">Nachricht senden</button></span></div>
        </form>
      </div>
      <div class="card-nap">
        <address><strong>{site.legalBrand}</strong>{site.address.street}<br />{site.address.zip} {site.address.city}</address>
        <ul class="icon-list" role="list">
          <li><Icon name="mail" /><div><strong>E-Mail</strong><p><a href={mailHref}>{site.email}</a></p></div></li>
          {telHref && <li><Icon name="phone" /><div><strong>Telefon</strong><p><a href={telHref}>{site.phone.display}</a></p></div></li>}
          {whatsappHref && <li><Icon name="chat" /><div><strong>WhatsApp</strong><p><a href={whatsappHref} rel="noopener" target="_blank">Nachricht schreiben</a></p></div></li>}
        </ul>
      </div>
    </div>
  </section>
</Base>
