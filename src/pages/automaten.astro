---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import Machine from '../components/Machine.astro';
import Marquee from '../components/Marquee.astro';
import { machines } from '../data/machines';
import { u } from '../lib/url';
---
<Base
  title="Automaten in Miesbach: Snacks & Getränke – AlpenBox24"
  description="Snacks, kalte Getränke, Regionales und mehr aus dem Automaten: Das bietet AlpenBox24 in Miesbach und Umgebung, rund um die Uhr. Finde den nächsten Standort."
  breadcrumbs={[{ name: 'Automaten', href: '/automaten/' }]}
>
  <PageHead title="Unsere Automaten in Miesbach" lead="Snacks, Getränke, Regionales und mehr. Rund um die Uhr, auch an Sonn- und Feiertagen." crumbs={[{ name: 'Automaten', href: '/automaten/' }]}>
    <nav class="cta-row mt-6" aria-label="Automatentypen">
      {machines.filter((m) => m.id !== 'standort').map((m) => <a class="chip" href={`#${m.id}`}>{m.name}</a>)}
    </nav>
  </PageHead>

  <section class="section" style="padding-top:0">
    <div class="wrap types">
      {machines.filter((m) => m.id !== 'standort').map((m, i) => (
        <article class="type" id={m.id} aria-labelledby={`h-${m.id}`}>
          <Photo name={m.photo as any} alt={m.alt} reveal={i === 0 ? undefined : 'clip'} eager={i === 0} crop={4 / 3} widths={[480, 800, 1200, 1600]} sizes="(min-width: 900px) min(56vw, 790px), 100vw" />
          <div>
            <span class="type__code" aria-hidden="true">{m.code}</span>
            <h2 id={`h-${m.id}`} data-reveal>{m.name}</h2>
            <p data-reveal style="--d:100">{m.line}</p>
            <p class="mt-5" data-reveal style="--d:180"><a class="link" href={u('/standorte/')}>Zu den Standorten</a></p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Marquee items={['Aussuchen', 'Fach auf', 'Mitnehmen', '24/7']} />

  <section class="section" aria-labelledby="spiel-title">
    <div class="wrap">
      <h2 id="spiel-title" data-reveal>Probier’s aus.</h2>
      <p class="muted mt-4" data-reveal>Drück ein Fach oder tipp den Code ein, wie am echten Automaten.</p>
      <div class="mt-7" data-reveal><Machine /></div>
    </div>
  </section>

  <section class="section section--fels">
    <div class="wrap grid-2">
      <h2 class="statement">Wo steht der nächste? <em>Hier entlang.</em></h2>
      <div><span class="signpost-wrap"><a class="signpost" href={u('/standorte/')}>Standorte ansehen</a></span></div>
    </div>
  </section>
</Base>
