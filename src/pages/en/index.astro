---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Horizon from '../../components/Horizon.astro';
import { machines } from '../../data/machines';
import { site, mailHref } from '../../data/site';
import { u } from '../../lib/url';
const tiles = machines.filter((m) => m.id !== 'wunsch').slice(0, 6);
const en: Record<string, string> = { snack: 'Snack machine', getraenke: 'Drinks machine', regional: 'Farm shop machine', faecher: 'Locker machine', brot: 'Bread machine', shop: '24/7 vending shop' };
---
<Base lang="en" hero title="AlpenBox24 – Vending machines: sales & setup" description="AlpenBox24 from Miesbach, Bavaria sells vending machines and sets them up for you: snacks, drinks, farm produce or a whole 24/7 vending shop. Get in touch.">
  <section class="hero" aria-labelledby="en-title">
    <div class="hero__media"><Photo name="automat-drei-nacht" alt="" eager credit={false} widths={[640, 1280, 1920]} sizes="100vw" position="62% 50%" /></div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__content">
      <h1 id="en-title"><span class="hero__big">Never closed.</span><span class="hero__sub">Vending machines, sold and set up.</span></h1>
      <p class="lead">We deliver your machine, install it and get it running. From Miesbach, Bavaria.</p>
      <div class="cta-row">
        <span class="signpost-wrap"><a class="signpost" href={mailHref}>Email us</a></span>
        <a class="btn" href={u('/')} hreflang="de" lang="de">Deutsch</a>
      </div>
    </div>
    <Horizon />
  </section>

  <section class="section">
    <div class="wrap">
      <div class="bento">
        {tiles.map((m, i) => (
          <a class:list={['bento__tile', `bento__tile--${i}`]} href={u(`/automaten/#${m.id}`)} hreflang="de">
            <Photo name={m.photo as any} alt={m.alt} credit={false} widths={[480, 800, 1200]} sizes="(min-width: 960px) 40vw, 100vw" />
            <span class="bento__label"><strong>{en[m.id]}</strong></span>
          </a>
        ))}
      </div>
      <p class="muted mt-6">Our own 24/7 vending box: {site.address.street}, {site.address.zip} {site.address.city}, open 24 hours. Email: <a href={mailHref}>{site.email}</a>. <a href={u('/impressum/')} hreflang="de">Legal notice</a> · <a href={u('/datenschutz/')} hreflang="de">Privacy</a></p>
    </div>
  </section>
</Base>
