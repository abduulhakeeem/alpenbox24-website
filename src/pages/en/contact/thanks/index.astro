---
import Base from '../../../../layouts/Base.astro';
import { u } from '../../../../lib/url';
---
<Base lang="en" title="Thanks for your message – AlpenBox24" description="Your message to AlpenBox24 has arrived." noindex>
  <section class="lost">
    <div class="wrap-text stack">
      <h1>Thanks! Your message has arrived.</h1>
      <p class="lead" style="margin-inline:auto">We will get back to you as soon as we can.</p>
      <p><span class="signpost-wrap"><a class="signpost" href={u('/en/products/')}>See products</a></span></p>
    </div>
  </section>
</Base>
