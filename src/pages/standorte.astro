---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MapBlock from '../components/MapBlock.astro';
import OpenNow from '../components/OpenNow.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { u } from '../lib/url';

const [main, ...more] = site.locations;
---
<Base
  title="Standorte: 24/7-Automaten in Miesbach – AlpenBox24"
  description="Hier stehen die Automaten von AlpenBox24: der 24/7-Minimarkt an der Bayrischzeller Straße in Miesbach und weitere Standorte. Rund um die Uhr geöffnet."
  breadcrumbs={[{ name: 'Standorte', href: '/standorte/' }]}
>
  <PageHead title="Unsere Standorte in Miesbach und Umgebung" lead="Hier findest du unsere Automaten. Rund um die Uhr geöffnet." crumbs={[{ name: 'Standorte', href: '/standorte/' }]} />

  {main && (
    <section class="section" style="padding-top:0" aria-labelledby="loc-0">
      <div class="wrap grid-2" style="align-items:start">
        <div class="card-nap">
          <OpenNow />
          <address><strong id="loc-0">{main.name}</strong>{main.street}<br />{main.zip} {main.city}</address>
          {main.note && <p class="muted">{main.note}</p>}
          <dl>
            {main.hours && <><dt>Geöffnet</dt><dd>{main.hours}</dd></>}
            <dt>Lage</dt><dd>Direkt an der B&nbsp;472 (Richtung Schliersee)</dd>
            <dt>Bahnhof Miesbach</dt><dd>ca. {site.directions.walkMinutesFromStation} Min. zu Fuß</dd>
            <dt>Bus</dt><dd>Haltestelle „{site.directions.nearestBusStop}“</dd>
            {site.directions.parkingDe && <><dt>Parken</dt><dd>{site.directions.parkingDe}</dd></>}
          </dl>
          <div class="cta-row">
            <span class="signpost-wrap"><a class="signpost" href={main.mapsUrl} rel="noopener" target="_blank">Route planen <Icon name="route" /></a></span>
          </div>
        </div>
        <MapBlock />
      </div>
    </section>
  )}

  {more.length > 0 && (
    <section class="section section--fels" aria-labelledby="weitere">
      <div class="wrap">
        <h2 id="weitere">Weitere Standorte</h2>
        <ul class="locs mt-7" role="list">
          {more.map((l) => (
            <li class="loc" data-reveal>
              <Icon name="pin" />
              <div>
                <h3>{l.name}</h3>
                <p class="muted">{l.address}</p>
                {l.hours && <p class="c-laerche">{l.hours}</p>}
                {l.note && <p class="muted">{l.note}</p>}
                <p class="mt-4"><a class="link" href={l.mapsUrl} rel="noopener" target="_blank">Route planen</a></p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap grid-2">
      <h2 class="statement">Platz für einen Automaten? <em>Sprich uns an.</em></h2>
      <div><a class="btn" href={u('/kontakt/?anliegen=standort#formular')}>Standort anbieten</a></div>
    </div>
  </section>
</Base>
<style>
  .locs { display: grid; gap: 1px; background: var(--c-grat); border: 1px solid var(--c-grat); border-radius: 6px; overflow: hidden; list-style: none; padding: 0; }
  @media (min-width: 760px) { .locs { grid-template-columns: repeat(2, 1fr); } }
  .loc { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1rem; padding: 1.5rem; background: var(--c-nacht); }
  .loc > :global(svg) { width: 2.4rem; height: 2.4rem; padding: .55rem; border-radius: 50%; background: var(--c-grat); color: var(--c-sonne); }
  .loc h3 { margin-bottom: .3rem; }
</style>
