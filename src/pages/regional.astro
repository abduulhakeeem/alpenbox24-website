---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base
  title="Regionale Produkte aus dem Oberland – AlpenBox24"
  description="Käse, Eier, Brotzeit und mehr von Erzeugern aus dem Landkreis Miesbach – rund um die Uhr im AlpenBox24 Minimarkt an der Bayrischzeller Straße."
  breadcrumbs={[{ name: 'Regional', href: '/regional/' }]}
>
  <PageHead
    title="Regionale Produkte aus dem Landkreis Miesbach"
    lead="Zwischen Tegernsee, Schliersee und Bayrischzell gibt es Höfe, Käsereien und Imker, deren Produkte jeder hier kennt. Einige davon holen wir zu AlpenBox24: rund um die Uhr, mitten in Miesbach."
    crumbs={[{ name: 'Regional', href: '/regional/' }]}
  />

  <section class="band" aria-label="Oberland">
    <Photo name="spitzingsee-alm" alt="Almwiesen und Bergwald über dem Spitzingsee, im Hintergrund die Gipfel des Mangfallgebirges" sizes="100vw" widths={[800, 1280, 1920]} />
    <div class="wrap band__text">
      <p class="statement" data-reveal>Kurze Wege. Bekannte Gesichter. <em>Geschmack aus der Gegend.</em></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap story">
      <div class="stack">
        <p class="kicker" data-reveal>Warum regional</p>
        <h2 data-reveal style="--d:80">Am Hof gibt’s das längst. Wir bringen es an die Hauptstraße.</h2>
        <p data-reveal style="--d:160">Im Landkreis Miesbach ist der Automat am Hof nichts Neues: Milch, Eier, Käse, Honig, Fleisch. Die Ökomodellregion Miesbach führt dafür sogar eine eigene Liste mit Hofläden und Verkaufsautomaten. Die Leute hier vertrauen dem Prinzip.</p>
        <p data-reveal style="--d:220">Für dich heißt das: Du kannst um Mitternacht eine ordentliche Brotzeit kaufen. Für die Erzeuger heißt das: ein zusätzlicher Verkaufsort an der B&nbsp;472, ohne eigenen Automaten.</p>
      </div>
      <div class="story__stack">
        <Photo name="hofautomat-eier" alt="Holzhütte mit zwei Warenautomaten, daneben Schilder für Honig aus eigener Imkerei und frische Eier" reveal="clip" />
        <Photo name="obatzda" alt="Teller mit Obatzda, garniert mit Zwiebelringen und Schnittlauch" widths={[400, 700]} sizes="(min-width: 960px) 25vw, 50vw" credit={false} />
      </div>
    </div>
  </section>

  <section class="section section--fels" aria-labelledby="erzeuger">
    <div class="wrap">
      <p class="kicker">Unsere Erzeuger</p>
      <h2 id="erzeuger">Wer bei uns im Fach liegt</h2>
      {site.producers.length ? (
        <div class="pledge mt-7">
          {site.producers.map((p) => (
            <div>
              <h3>{p.name}</h3>
              <p class="c-sonne">{p.village}, {p.distanceKm} km entfernt</p>
              <p class="mt-4">{p.blurbDe}</p>
              <p class="mt-4"><strong>Bei uns:</strong> {p.productsDe}</p>
              {p.url && <p class="mt-4"><a class="link" href={p.url} rel="noopener" target="_blank">Zum Erzeuger</a></p>}
            </div>
          ))}
        </div>
      ) : (
        <div class="grid-2 mt-6">
          <div class="stack">
            <p class="lead"><strong>Regionales im Aufbau.</strong> Wir sprechen gerade mit Höfen und Manufakturen aus dem Landkreis. Sobald die ersten Produkte im Automaten sind, stellen wir dir hier die Menschen dahinter vor, mit Namen, Ort und Entfernung.</p>
            <p class="muted">Bis dahin gilt: Wir schreiben keinen Hof hin, der nicht wirklich liefert.</p>
          </div>
          <div class="pledge" style="grid-template-columns:1fr">
            <div><Icon name="leaf" /><h3>Aus dem Landkreis</h3><p>Erzeuger aus dem Oberland, mit Ort und Entfernung angegeben.</p></div>
            <div><Icon name="shield" /><h3>Nur mit Zustimmung</h3><p>Namen und Fotos zeigen wir nur, wenn der Hof einverstanden ist.</p></div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <Photo name="kaeselager" alt="Lange Holzregale voller reifender Käselaibe in einem Gewölbekeller" reveal="clip" ratio="4/3" />
      <div class="stack">
        <p class="kicker">Für Höfe und Manufakturen</p>
        <h2>Erzeuger werden</h2>
        <p class="lead muted">Du stellst im Oberland Lebensmittel her und suchst einen zusätzlichen Verkaufsplatz, der nie schließt? Melde dich. Wir übernehmen Kühlung, Bezahlung und Verkauf.</p>
        <div><span class="signpost-wrap"><a class="signpost" href={u('/kontakt/?anliegen=erzeuger#formular')}>Kontakt aufnehmen</a></span></div>
      </div>
    </div>
  </section>
</Base>
