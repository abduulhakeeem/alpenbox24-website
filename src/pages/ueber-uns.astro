---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import { googleDirectionsUrl } from '../data/site';
import { STAGING } from '../lib/url';
---
<Base
  title="Über uns – AlpenBox24 aus Miesbach"
  description="Wer hinter AlpenBox24 steckt und warum es in Miesbach einen Minimarkt gibt, der nie zumacht. Regional verwurzelt, rund um die Uhr für dich da."
  breadcrumbs={[{ name: 'Über uns', href: '/ueber-uns/' }]}
>
  <PageHead
    title="Über AlpenBox24"
    lead="Ein heller Laden an einer dunklen Straße. Snacks, Getränke und Regionales für alle, die in Miesbach nach acht Uhr abends noch etwas brauchen."
    crumbs={[{ name: 'Über uns', href: '/ueber-uns/' }]}
  />

  <section class="section" style="padding-top:0">
    <div class="wrap story">
      <Photo name="wendelstein-sonne" alt="Die Sonne geht neben dem Wendelstein unter, der Gipfel steht als dunkle Silhouette vor orangem Himmel" reveal="clip" />
      <div class="stack">
        <p class="kicker" data-reveal>Das Logo</p>
        <h2 data-reveal style="--d:80">Sonne, Grat, offen.</h2>
        <p data-reveal style="--d:160">Unser Logo zeigt, was du hier jeden Abend sehen kannst: eine Sonne, die hinter den Bergen verschwindet. Die weiße Linie ist der Grat, der das Oberland zusammenhält. Und die 24 in Lärchengrün heißt: Licht bleibt an.</p>
        <div class="logo-demo" data-reveal style="--d:240"><Mark label="AlpenBox24 Logo" /></div>
      </div>
    </div>
  </section>

  <section class="section section--fels">
    <div class="wrap-text stack" style="--stack:1.3em">
      <p class="kicker">Unsere Geschichte</p>
      <h2>Wer wir sind</h2>
      {STAGING ? (
        <p class="tbc" style="display:block;padding:1rem">Hier kommt die Gründungsgeschichte vom Betreiber hin: wer ihr seid, euer Bezug zu Miesbach und ein ehrlicher Satz, warum ihr AlpenBox24 macht. Bitte nicht erfinden lassen.</p>
      ) : (
        <p>[TBC]</p>
      )}
      <h2 class="mt-7">Warum Miesbach</h2>
      <p>Miesbach liegt da, wo das Oberland anfängt. Wer an den Schliersee, nach Bayrischzell oder zum Skifahren will, kommt hier durch. Und wer hier wohnt, steht nach acht Uhr abends und am Sonntag oft vor verschlossenen Türen. Für beide sind wir da.</p>
      <p>Seit August 2025 erlaubt Bayern kleinen Läden ohne Personal, rund um die Uhr zu öffnen, auch am Sonntag. Genau so ein Laden sind wir: Alles läuft über Automaten, nachgefüllt und geputzt wird tagsüber.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Worauf du dich verlassen kannst</h2>
      <div class="pledge mt-7">
        <div data-reveal><Icon name="sparkle" /><h3>Hell und sauber</h3><p>Wir halten den Laden sauber und beleuchtet und füllen regelmäßig nach.</p></div>
        <div data-reveal style="--d:120"><Icon name="shield" /><h3>Ab 18 heißt ab 18</h3><p>Produkte ab 18 gibt es nur nach Altersprüfung, ohne Ausnahme.</p></div>
        <div data-reveal style="--d:240"><Icon name="leaf" /><h3>Aus der Gegend</h3><p>Wir arbeiten mit Erzeugern aus dem Landkreis, weil das für uns zum Oberland gehört.</p></div>
      </div>
    </div>
  </section>

  <section class="band" aria-label="Schau vorbei">
    <Photo name="tegernsee-panorama-nacht" alt="" sizes="100vw" widths={[800, 1280, 1920, 2560]} credit={false} />
    <div class="wrap band__text">
      <p class="statement">Schau vorbei. <em>Wir haben offen.</em></p>
      <div class="cta-row mt-6"><span class="signpost-wrap"><a class="signpost" href={googleDirectionsUrl} rel="noopener" target="_blank">Route planen</a></span></div>
    </div>
  </section>
</Base>
<style>
  .logo-demo { max-width: 20rem; padding: 2rem; background: var(--c-nacht); border: 1px solid var(--c-grat); border-radius: 6px; }
  .logo-demo :global(.mark__sun) { animation: logo-sun 3s var(--ease-out) both; transform-box: fill-box; transform-origin: center; }
  .logo-demo :global(.mark__ridge) { stroke-dasharray: 400; stroke-dashoffset: 400; animation: logo-ridge 2.2s .3s var(--ease-in-out) forwards; }
  @keyframes logo-sun { from { transform: translateY(40%); opacity: 0; } }
  @keyframes logo-ridge { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .logo-demo :global(.mark__sun), .logo-demo :global(.mark__ridge) { animation: none; stroke-dashoffset: 0; } }
</style>
