---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import Mark from '../components/Mark.astro';
import { u } from '../lib/url';
---
<Base
  title="Über uns – AlpenBox24 aus Miesbach"
  description="AlpenBox24 aus Miesbach betreibt Automaten für Snacks, Getränke und Regionales, rund um die Uhr geöffnet. Wer wir sind und wofür unser Logo steht."
  breadcrumbs={[{ name: 'Über uns', href: '/ueber-uns/' }]}
>
  <PageHead title="Über AlpenBox24" lead="Aus Miesbach. Automaten, die nie zumachen." crumbs={[{ name: 'Über uns', href: '/ueber-uns/' }]} />

  <section class="section" style="padding-top:0">
    <div class="wrap story">
      <Photo name="wendelstein-sonne" alt="Die Sonne geht neben dem Wendelstein unter, der Gipfel steht als dunkle Silhouette vor orangem Himmel" reveal="clip" />
      <div class="stack">
        <h2 data-reveal>Wer wir sind</h2>
        <p class="lead muted" data-reveal style="--d:120">Wir stellen unsere Automaten selbst auf, befüllen sie und halten sie am Laufen. Damit du Snacks, Getränke und Regionales bekommst, wann immer du willst.</p>
        <p class="muted" data-reveal style="--d:180">Unser Logo: die Sonne hinter den Bergen, darüber der weiße Grat. Und die 24, weil bei uns das Licht nie ausgeht.</p>
        <div class="logo-demo" data-reveal style="--d:240"><Mark label="AlpenBox24 Logo" /></div>
      </div>
    </div>
  </section>

  <section class="band" aria-label="Nachts">
    <Photo name="tegernsee-panorama-nacht" alt="" sizes="100vw" widths={[800, 1280, 1920, 2560]} credit={false} />
    <div class="wrap band__text">
      <p class="statement">Licht an. <em>Rund um die Uhr.</em></p>
      <div class="cta-row mt-6"><span class="signpost-wrap"><a class="signpost" href={u('/standorte/')}>Standorte ansehen</a></span></div>
    </div>
  </section>
</Base>
<style>
  .logo-demo { max-width: 20rem; padding: 2rem; background: var(--c-nacht); border: 1px solid var(--c-grat); border-radius: 6px; }
  .logo-demo :global(.mark__sun) { animation: logo-sun 3s var(--ease-out) both; transform-box: fill-box; transform-origin: center; }
  .logo-demo :global(.mark__ridge) { stroke-dasharray: 400; stroke-dashoffset: 400; animation: logo-ridge 2.2s .3s var(--ease-in-out) forwards; }
  @keyframes logo-sun { from { transform: translateY(40%); opacity: 0; } }
  @keyframes logo-ridge { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .logo-demo :global(.mark__sun), .logo-demo :global(.mark__ridge) { animation: none; stroke-dashoffset: 0; } }
</style>
