---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MapBlock from '../components/MapBlock.astro';
import OpenNow from '../components/OpenNow.astro';
import Icon from '../components/Icon.astro';
import { site, googleDirectionsUrl, appleDirectionsUrl } from '../data/site';
---
<Base
  title="AlpenBox24 Miesbach – 24/7 Automaten-Minimarkt"
  description="Die AlpenBox24 an der Bayrischzeller Straße 2-8 in Miesbach: Snacks, Getränke und Regionales aus dem Automaten, täglich 0–24 Uhr, auch an Sonn- und Feiertagen."
  breadcrumbs={[{ name: 'Miesbach', href: '/miesbach/' }]}
>
  <PageHead title="AlpenBox24 Miesbach" lead="Unser eigener 24/7-Minimarkt. Snacks, Getränke, Regionales. Immer offen." crumbs={[{ name: 'Miesbach', href: '/miesbach/' }]} />

  <section class="section" style="padding-top:0">
    <div class="wrap grid-2" style="align-items:start">
      <div class="card-nap">
        <OpenNow />
        <address><strong>{site.legalBrand}</strong>{site.address.street}<br />{site.address.zip} {site.address.city}</address>
        <dl>
          <dt>Geöffnet</dt><dd>{site.hours.labelDe}</dd>
          <dt>Bezahlen</dt><dd>{site.payment.shortDe}</dd>
          <dt>Bahnhof</dt><dd>ca. {site.directions.walkMinutesFromStation} Min. zu Fuß</dd>
          {site.directions.parkingDe && <><dt>Parken</dt><dd>{site.directions.parkingDe}</dd></>}
        </dl>
        <div class="cta-row">
          <span class="signpost-wrap"><a class="signpost" href={googleDirectionsUrl} rel="noopener" target="_blank">Route planen <Icon name="route" /></a></span>
          <a class="btn" href={appleDirectionsUrl} rel="noopener" target="_blank">Apple Karten</a>
        </div>
      </div>
      <MapBlock />
    </div>
  </section>
</Base>
