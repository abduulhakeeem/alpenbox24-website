---
/** Self-hosted map built from OpenStreetMap data (scripts/build-map.mjs → karte-miesbach.svg cropped around the shop, lazy-loaded).
 *  Car-first: the shop sits in the middle, the B 472 is labelled in both directions. */
import mapUrl from '../assets/map/karte-miesbach.svg?url';
import ov from '../data/map-overlay.json';
import { googleDirectionsUrl } from '../data/site';
interface Props { lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props;
const en = lang === 'en';
const [sx, sy] = ov.shop;
const [, , w, h] = ov.crop.split(' ').map(Number);
// Where the B 472 leaves the crop (from the OSM geometry, see build-map.mjs)
const north = [1154, 318], south = [870, 1011];
---
<div class="map" data-map>
  <img class="map__base" src={mapUrl} alt="" width={w} height={h} loading="lazy" decoding="async" />
  <svg class="map__overlay" viewBox={ov.crop} preserveAspectRatio="xMidYMid slice" role="img" aria-label={en ? 'Map: AlpenBox24 on Bayrischzeller Straße (B 472) in Miesbach' : 'Karte: AlpenBox24 an der Bayrischzeller Straße (B 472) in Miesbach'}>
    <g class="map__dir">
      <text class="map__label" x={north[0] + 26} y={north[1] + 60}>{en ? '↑ Munich' : '↑ München'}</text>
      <text class="map__label" x={south[0] + 30} y={south[1] - 80}>{en ? '↓ Schliersee · Bayrischzell' : '↓ Schliersee · Bayrischzell'}</text>
    </g>
    {ov.labels.stadtplatz && <text class="map__label" x={ov.labels.stadtplatz[0]} y={ov.labels.stadtplatz[1] - 30} text-anchor="middle">Stadtplatz</text>}
    <text class="map__label map__label--road" x={sx + 70} y={sy + 150}>B 472</text>
    <g transform={`translate(${sx} ${sy})`}>
      <circle class="map__pin-pulse" r="16" />
      <circle r="20" fill="#F68A2B" stroke="#0D0C0B" stroke-width="5" />
      <circle r="7" fill="#0D0C0B" />
      <text class="map__label map__label--shop" x="0" y="-44" text-anchor="middle">AlpenBox24</text>
    </g>
  </svg>
  <a class="map__attr" href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">© OpenStreetMap-Mitwirkende</a>
  <a href={googleDirectionsUrl} class="visually-hidden" rel="noopener" target="_blank">{en ? 'Open directions in Google Maps' : 'Route in Google Maps öffnen'}</a>
</div>
