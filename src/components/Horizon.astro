---
/** Hero horizon: the logo, unfolded. Sun rises behind the ridge while the ridge line draws itself. */
---
<div class="horizon" aria-hidden="true">
  <div class="horizon__sun"></div>
  <svg viewBox="-4 -4 281.4 102.8" preserveAspectRatio="none">
    <path class="horizon__fill" d="M0 90.8L60.8 51.9L88.1 67.2L142.8 0L185.3 54.3L212.7 30.7L273.4 86.1L273.4 102.8L0 102.8Z" />
    <path class="horizon__snow" d="M142.8 3.5L136.7 38.9L106.3 81.4L145.8 56.6L158 43.6ZM212.7 33L224.8 56.6L255.2 86.1L227.9 50.7Z" />
    <path class="horizon__line" pathLength="1" d="M0 90.8L60.8 51.9L88.1 67.2L142.8 0L185.3 54.3L212.7 30.7L273.4 86.1" />
  </svg>
</div>
