---
/**
 * "Ein Tag am Automaten": short scroll-scrubbed day in four real photos of the Oberland.
 * The clock runs through the day while the photos crossfade (sunrise → noon → sunset → night).
 * No JS or prefers-reduced-motion: a plain list of the four moments (real, indexable text), no stage images loaded.
 * Engine: src/scripts/app.ts ("Day cycle"). Styles: src/styles/daycycle.css.
 */
import Photo from './Photo.astro';
import credits from '../data/photo-credits.json';
import { u } from '../lib/url';
interface Props { lang?: 'de' | 'en' }
const en = Astro.props.lang === 'en';
const L = en ? 'en' : 'de';
const moments = [
  { time: '06:30', min: 390, photo: 'tag-sonnenaufgang', de: ['Vor der Bergtour', 'Noch schnell Wasser und Brotzeit holen.'], en: ['Before the hike', 'Grab water and a snack for the mountain.'] },
  { time: '12:30', min: 750, photo: 'tag-schliersee-mittag', de: ['Mittagspause', 'Kurz rüber, was rausziehen, weiter geht’s.'], en: ['Lunch break', 'Pop over, pick something, carry on.'] },
  { time: '20:30', min: 1230, photo: 'wendelstein-sonne', de: ['Die Läden sind zu', 'Am Automaten brennt noch Licht.'], en: ['The shops are shut', 'Our machine is still lit.'] },
  { time: '02:00', min: 1560, photo: 'tegernsee-nacht', de: ['Schicht vorbei', 'Was Kaltes zu trinken, dann heim.'], en: ['Night shift over', 'Something cold to drink, then home.'] },
] as const;
const byline = moments.map((m) => { const c = credits[m.photo]; return `${c.author} (${c.license})`; }).join(', ');
---
<section class="day" data-day aria-labelledby="day-title" data-mins={JSON.stringify(moments.map((m) => m.min))}>
  <div class="dc-stage" aria-hidden="true">
    {moments.map((m, i) => (
      <div class="dc-shot" data-shot={i}>
        <Photo name={m.photo} alt="" credit={false} widths={[640, 1024, 1600, 2000]} sizes="100vw" quality={62} />
      </div>
    ))}
    <div class="dc-shade"></div>
    <strong class="dc-clock" data-day-time>{moments[0].time}</strong>
  </div>

  <div class="wrap dc-intro">
    <h2 id="day-title">{en ? 'A day at the machine' : 'Ein Tag am Automaten'}</h2>
  </div>

  <div class="dc-fore">
    <ol class="wrap dc-list">
      {moments.map((m, i) => (
        <li class="dc-moment" data-moment={i}>
          <span class="dc-moment__time">{m.time}</span>
          <h3>{m[L][0]}</h3>
          <p>{m[L][1]}</p>
        </li>
      ))}
    </ol>
    <a class="dc-credit" href={u('/bildnachweise/')} hreflang={en ? 'de' : undefined}>{en ? 'Photos' : 'Fotos'}: {byline}</a>
  </div>
</section>
