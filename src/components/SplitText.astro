---
/** Splits a line into animated characters. Screen readers get the plain text once. */
interface Props { text: string; base?: number; class?: string }
const { text, base = 120, class: cls } = Astro.props;
let i = 0;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, i: i++ })));
---
<span class:list={['split', cls]} style={`--base:${base}ms`}><span class="visually-hidden">{text}</span><span aria-hidden="true">{words.map((w, wi) => (<><span class="w">{w.map((c) => <span class="ch" style={`--i:${c.i}`}>{c.ch}</span>)}</span>{wi < words.length - 1 && ' '}</>))}</span></span>
