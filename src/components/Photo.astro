---
/**
 * Responsive photo with licence credit. Photos live in src/assets/photos/<key>.jpg,
 * credits in src/data/photo-credits.json (CC licences require attribution → small credit link + /bildnachweise/).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import credits from '../data/photo-credits.json';
import { u } from '../lib/url';

interface Props {
  name: keyof typeof credits;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  credit?: boolean;
  reveal?: string;
  ratio?: string;
  position?: string;
  quality?: number;
  /** Pre-crop the generated files to this width/height ratio (e.g. 4/3) when the frame crops anyway. */
  crop?: number;
}
const { name, alt, widths = [480, 800, 1200, 1600], sizes = '(min-width: 960px) 50vw, 100vw', eager = false, class: cls, credit = true, reveal, ratio, position, quality = 72, crop } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const img = all[`../assets/photos/${name}.jpg`]?.default;
if (!img) throw new Error(`Photo not found: ${name}`);
const c = credits[name];
const short = `Foto: ${c.author} · ${c.license}`;
---
<figure class:list={['photo', cls]} data-reveal={reveal} style={[ratio && `aspect-ratio:${ratio}`, position && `--pos:${position}`].filter(Boolean).join(';') || undefined}>
  <Picture src={img} alt={alt} widths={widths} width={Math.max(...widths)} height={Math.round(crop ? Math.max(...widths) / crop : Math.max(...widths) * c.height / c.width)} fit={crop ? 'cover' : undefined} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="webp" quality={quality} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} style={position ? `object-position:${position}` : undefined} />
  {credit && <a class="photo__credit" href={u('/bildnachweise/') + '#' + name} title={`${c.title} – ${c.author}, ${c.license}`}>{short}</a>}
  <slot />
</figure>
