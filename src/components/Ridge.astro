---
/** Signature RidgeLine: the logo's ridge polyline, stretched as a horizon/divider. */
interface Props { class?: string; draw?: boolean }
const { class: cls = '', draw = false } = Astro.props;
---
<svg class:list={['ridge', { 'ridge--draw': draw }, cls]} viewBox="-4 -4 281.4 98.8" preserveAspectRatio="none" aria-hidden="true" data-reveal-target={draw ? '' : undefined}>
  <path pathLength="1" d="M0 90.8L60.8 51.9L88.1 67.2L142.8 0L185.3 54.3L212.7 30.7L273.4 86.1" />
</svg>
