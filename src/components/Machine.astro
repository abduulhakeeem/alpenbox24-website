---
/** Interactive vending machine. No JS: every slot is a plain link to its Sortiment section. */
import Icon from './Icon.astro';
import { slots } from '../data/sortiment';
import { u } from '../lib/url';
---
<div class="machine" data-machine>
  <div class="machine__body">
    <div class="machine__top">
      <span class="machine__brand" aria-hidden="true">ALPEN BOX <b>24</b></span>
      <span class="machine__led" aria-hidden="true"><i></i><i></i></span>
    </div>
    <div class="machine__glass" role="list" aria-label="Fächer im Automaten">
      {slots.map((s) => (
        <a class="slot" role="listitem" href={u(s.href)} data-slot={s.code} data-name={s.name} style={`--tone:${s.tone}`}>
          <Icon name={s.icon} class="slot__item" />
          <span class="slot__coil" aria-hidden="true"></span>
          <span class="slot__label"><span class="slot__code">{s.code}</span>{s.name}</span>
        </a>
      ))}
    </div>
    {slots.map((s) => (
      <div hidden data-for={s.code}>
        <p class="kicker">Fach {s.code}</p>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <a class="link" href={u(s.href)}>{s.cta}</a>
      </div>
    ))}
    <div class="machine__panel">
      <div class="machine__screen" data-screen aria-live="polite">Fach wählen</div>
      <div class="keypad" aria-label="Tastenfeld">
        {['A', 'B', 'C', '1', '2', '3', 'DEL', 'OK'].map((k) => <button type="button" data-key={k} aria-label={k === 'DEL' ? 'Eingabe löschen' : k === 'OK' ? 'Bestätigen' : `Taste ${k}`}>{k === 'DEL' ? '⌫' : k}</button>)}
      </div>
      <div class="machine__tray" data-tray aria-hidden="true"></div>
    </div>
  </div>
  <div>
    <div class="machine__info" data-info aria-live="polite">
      <p class="kicker">So funktioniert der Automat hier</p>
      <h3>Tipp ein Fach an.</h3>
      <p>Oder gib den Code am Tastenfeld ein, so wie im Laden. Jedes Fach zeigt dir eine Kategorie aus unserem Sortiment.</p>
    </div>
    <p class="machine__hint">Die Fächer hier sind Beispiele. Das echte Sortiment wechselt mit Saison und Nachfrage, Preise stehen am Automaten.</p>
  </div>
</div>
