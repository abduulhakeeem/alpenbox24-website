---
/** Interactive vending machine: pick a machine type. No JS: every slot is a plain link to its section. */
import Icon from './Icon.astro';
import { machines } from '../data/machines';
import { u } from '../lib/url';
---
<div class="machine" data-machine>
  <div class="machine__body">
    <div class="machine__top">
      <span class="machine__brand" aria-hidden="true">ALPEN BOX <b>24</b></span>
      <span class="machine__led" aria-hidden="true"><i></i><i></i></span>
    </div>
    <ul class="machine__glass" aria-label="Automatentypen">
      {machines.map((m) => (
        <li><a class="slot" href={u(`/automaten/#${m.id}`)} data-slot={m.code} data-name={m.name} style={`--tone:${m.tone}`}>
          <Icon name={m.icon} class="slot__item" />
          <span class="slot__coil" aria-hidden="true"></span>
          <span class="slot__label"><span class="slot__code">{m.code}</span>{m.name}</span>
        </a></li>
      ))}
    </ul>
    {machines.map((m) => (
      <div hidden data-for={m.code}>
        <p class="kicker">Fach {m.code}</p>
        <h3>{m.name}</h3>
        <p>{m.line}</p>
        <a class="link" href={u(m.id === 'standort' ? '/kontakt/?anliegen=standort#formular' : '/standorte/')}>{m.id === 'standort' ? 'Standort anbieten' : 'Zu den Standorten'}</a>
      </div>
    ))}
    <div class="machine__panel">
      <div class="machine__screen" data-screen aria-live="polite">Fach wählen</div>
      <div class="keypad" role="group" aria-label="Tastenfeld">
        {['A', 'B', 'C', '1', '2', '3', 'DEL', 'OK'].map((k) => <button type="button" data-key={k} aria-label={k === 'DEL' ? 'Eingabe löschen' : k === 'OK' ? 'Bestätigen' : `Taste ${k}`}>{k === 'DEL' ? '⌫' : k}</button>)}
      </div>
      <div class="machine__tray" data-tray aria-hidden="true"></div>
    </div>
  </div>
  <div>
    <div class="machine__info" data-info aria-live="polite">
      <p class="kicker">Automat zum Ausprobieren</p>
      <h3>Such dir ein Fach aus.</h3>
      <p>Zum Beispiel A3 eintippen und mit OK bestätigen.</p>
    </div>
  </div>
</div>
